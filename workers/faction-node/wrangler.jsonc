{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slink-faction-node-test",
  "main": "worker.js",
  "compatibility_date": "2026-08-06",
  "durable_objects": { "bindings": [
    { "name": "DIRECTORY", "class_name": "FactionDirectory" },
    { "name": "ROOMS", "class_name": "ChatRoom" }
  ] },
  "migrations": [{ "tag": "faction-node-v1", "new_sqlite_classes": ["FactionDirectory", "ChatRoom"] }],
  "vars": { "SLINK_NODE_ID": "unregistered", "SLINK_FACTION_ID": "0", "SLINK_CENTRAL_URL": "https://slinkcontributionworker.richard-johnson554.workers.dev", "ALLOWED_ORIGINS": "https://www.torn.com", "RETENTION_DAYS": "30", "MAX_ROOM_MESSAGES": "10000" },
  "observability": { "enabled": false }
}
