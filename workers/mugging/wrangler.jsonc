{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "slinkmuggingworker",
  "main": "worker.js",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "MUGGING_MAX_CALLS_PER_RUN": "100"
  },
  "d1_databases": [
    {
      "binding": "MUGGING_DB",
      "database_name": "slink-mugging",
      "database_id": "efa825a2-7269-406b-bb4e-bee3315afd10",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MUGGING_BUCKET",
      "bucket_name": "slink-mugging-data"
    }
  ],
  "services": [
    {
      "binding": "CONTRIBUTION_SERVICE",
      "service": "slinkcontributionworker"
    }
  ],
  "secrets": {
    "required": [
      "CONTRIBUTION_SERVICE_TOKEN",
      "MUGGING_SERVICE_TOKEN"
    ]
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
